<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:paddingTop="5mm"
    android:paddingBottom="5mm">

    <!-- Compatible mode (TextureView): the extra calculated zoom scales this view, which a SurfaceView does not do reliably. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.galker.pointandidentify.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status block (data, compass, offline, update progress) on a dark plate for legibility. -->
    <TextView
        android:id="@+id/dataStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#99000000"
        android:lineSpacingMultiplier="1.1"
        android:padding="8dp"
        android:textAlignment="viewStart"
        android:textColor="@android:color/white"
        android:textDirection="locale"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Everything under the status block starts below this barrier. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="dataStatusText" />

    <!-- Small north indicator, left edge (the zoom bar owns the right edge); camera heading below it. -->
    <com.galker.pointandidentify.ui.CompassView
        android:id="@+id/compassView"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarrier" />

    <TextView
        android:id="@+id/azimuthText"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#99000000"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@android:color/white"
        android:textDirection="ltr"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="@id/compassView"
        app:layout_constraintRight_toRightOf="@id/compassView"
        app:layout_constraintTop_toBottomOf="@id/compassView" />

    <!-- Zoom: vertical bar on the right edge, minimum at the bottom, maximum at the top, zoom value at the thumb.
         Logarithmic scale (0..1 maps to the min..max of camera zoom times the extra calculated zoom). -->
    <com.galker.pointandidentify.ui.ZoomBarView
        android:id="@+id/zoomBar"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/captureButton"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarrier" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/captureButton"
        android:layout_width="110dp"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#D32F2F"
        android:text="@string/btn_capture"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom row: exit, help, capture (middle), settings (gear icon). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/helpButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="8dp"
        android:contentDescription="@string/btn_help"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="@string/btn_help_symbol"
        android:textSize="22sp"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="@id/captureButton"
        app:layout_constraintRight_toLeftOf="@id/captureButton"
        app:layout_constraintTop_toTopOf="@id/captureButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exitButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="8dp"
        android:contentDescription="@string/btn_exit"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="@string/btn_exit_symbol"
        android:textSize="20sp"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="@id/captureButton"
        app:layout_constraintRight_toLeftOf="@id/helpButton"
        app:layout_constraintTop_toTopOf="@id/captureButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:contentDescription="@string/btn_settings"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:cornerRadius="24dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="26dp"
        app:layout_constraintBottom_toBottomOf="@id/captureButton"
        app:layout_constraintLeft_toRightOf="@id/captureButton"
        app:layout_constraintTop_toTopOf="@id/captureButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
